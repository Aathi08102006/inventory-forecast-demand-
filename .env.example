# Demandly AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Anthropic API (optional) ─────────────────────────────────────────────────
# Required only for the What-If? AI chat feature.
# Without this, the app falls back to local rule-based responses.
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Server configuration ─────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0

# ── Feature flags ────────────────────────────────────────────────────────────
# Set to "false" to disable the AI chat feature entirely
ENABLE_LLM=true

# ── Data paths (defaults relative to project root) ──────────────────────────
DATASET_PATH=dataset/demand_history.csv
MODELS_PATH=models/
